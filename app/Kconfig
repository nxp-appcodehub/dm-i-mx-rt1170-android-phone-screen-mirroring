source "Kconfig.zephyr"

config NET_STACK_CODE_RELOCATE
	bool "Relocate networking code into RAM"
	select CODE_DATA_RELOCATION
	help
	  Relocate networking code into RAM when running the zperf
	  sample. Can improve performance on platforms with fast code
	  RAM.

if NET_STACK_CODE_RELOCATE

config NET_STACK_CODE_RAM_NAME
	string "Networking code RAM location"
	default "RAM"
	help
	  Region to relocate networking code to

endif # NET_STACK_CODE_RELOCATE

config RECV_THREAD_PRIO
	int "Receiving thread priority"
	default 3
	help
	  Set the packet receiving thread preemptive priority

config DECODE_THREAD_PRIO
	int "Decode thread priority"
	default 5
	help
	  Set the frame decoding thread preemptive priority

config STATS_MONITOR
	bool "Enable statistics monitor thread (FPS and CPU load)"
	default y
	help
	  Start a dedicated background thread that periodically logs the
	  measured frames-per-second (FPS) rate of the mirroring pipeline and,
	  when CONFIG_CPU_LOAD is enabled, the current CPU load. Useful for
	  benchmarking throughput and system utilization.

if STATS_MONITOR

config STATS_MONITOR_INTERVAL
	int "Statistics reporting interval (seconds)"
	default 1
	help
	  How often, in seconds, the measured FPS and CPU load are logged.

config STATS_MONITOR_THREAD_PRIO
	int "Statistics monitor thread priority"
	default 4
	help
	  Preemptive priority of the statistics monitor thread. Kept above the
	  receive (RECV_THREAD_PRIO) and decode (DECODE_THREAD_PRIO) threads so
	  that, even when the mirroring pipeline saturates the CPU, the monitor
	  still wakes on schedule and reports FPS and CPU load. Its workload is
	  tiny (a counter read, a CPU-load read and one log line per interval),
	  so the brief preemption does not measurably affect throughput.

endif # STATS_MONITOR

config JPEG_SLAB_SIZE
	int "Size of a jpeg frame buffer slab (in KB)"
	default 512
	help
	  Size of a jpeg frame buffer slab in kilobytes

config JPEG_SLAB_COUNT
	int "Number of jpeg frame buffer slabs"
	default 20
	help
	  Number of slabs to allocate for JPEG frame buffering

choice
	prompt "Control Event protocol"
	default CONTROL_EVENT_TCP

config CONTROL_EVENT_UDP
	bool "Control UDP protocol"
	help
		Control events is reporting using UDP protocol

config CONTROL_EVENT_TCP
	bool "Control TCP protocol"
	help
		Touch events is reporting using TCP protocol

endchoice
